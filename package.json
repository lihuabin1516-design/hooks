{
  "name": "paneforge-hooks-tooling",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Agent hooks governance layer for task scope, policy gates, and auditable enforcement.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/write-runtime-identity.mjs",
    "cli": "node dist/src/cli.js",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke && npm run smoke:mcp"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "proper-lockfile": "^4.1.2",
    "zod": "4.1.12"
  }
}
